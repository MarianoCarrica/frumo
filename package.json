{
  "name": "frumo-cli",
  "version": "0.2.0",
  "description": "Unofficial, read-only CLI that finds what drives your PostHog bill and prints ready-to-paste fixes with dollar estimates. Not affiliated with PostHog Inc.",
  "license": "MIT",
  "author": "Mariano Ventures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarianoCarrica/frumo.git"
  },
  "homepage": "https://github.com/MarianoCarrica/frumo#readme",
  "bugs": {
    "url": "https://github.com/MarianoCarrica/frumo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "bin": {
    "frumo": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures/demo-snapshot.json",
    "fixtures/sentry-demo-snapshot.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "posthog",
    "analytics",
    "billing",
    "cost",
    "audit",
    "cli",
    "session-replay",
    "feature-flags"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node dist/cli.js demo",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "fixture:demo": "node scripts/make-demo-fixture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
